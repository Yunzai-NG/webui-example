{
  "name": "webui-example",
  "version": "0.4.0",
  "description": "Yunzai NG 面板插件示例：一言、日历、时钟、跑马灯与「跟着主题走」五枚组件，外加一款示例主题「薄荷」；含 node 侧入口与自带样式表",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Yunzai-NG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yunzai-NG/webui-example.git"
  },
  "homepage": "https://github.com/Yunzai-NG/webui-example",
  "webuiPanel": {
    "server": "server/index.js",
    "style": "style.css",
    "config": {
      "type": "object",
      "properties": {
        "hitokotoApi": {
          "type": "string",
          "title": "一言接口",
          "description": "取句子的接口地址，由本包的 node 侧代为请求（故不受浏览器 CORS 限制）。留空按默认值算。响应里的 hitokoto / text / content 任一字段都认，from / from_who 亦然，故换成自建镜像多半不必改代码。",
          "default": "https://v1.hitokoto.cn",
          "group": "一言组件",
          "order": 10
        }
      }
    }
  },
  "webuiTheme": {
    "id": "example-mint",
    "name": "薄荷（示例）",
    "description": "照抄用的最小主题：一套令牌、开关表情包滑块、九宫格卡片边框、空状态插图与两枚导航图标。只有浅色。",
    "license": "AGPL-3.0-or-later",
    "schemes": [
      "light"
    ],
    "style": "theme/theme.css",
    "preview": "theme/preview.svg",
    "icons": {
      "mode": "stroke",
      "nav": {
        "overview": "M12 21c0-8 4-14 9-16-1 7-4 13-9 16zM12 21c0-6-3-10-8-12 0 6 3 10 8 12",
        "appearance": "M12 3c4 4 6 7 6 10a6 6 0 0 1-12 0c0-3 2-6 6-10z"
      }
    },
    "slots": {
      "switch.thumb.on": "theme/art/switch-on.svg",
      "switch.thumb.off": "theme/art/switch-off.svg",
      "frame.card": {
        "image": "theme/art/frame.svg",
        "slice": 24,
        "width": "20px"
      },
      "empty": "theme/art/empty.svg"
    },
    "options": {
      "accentHue": false,
      "radius": true,
      "backdrop": true
    },
    "backdrop": "gradient"
  },
  "dependencies": {
    "lunar-typescript": "1.8.6"
  }
}
